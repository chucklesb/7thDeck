#!/bin/bash
# The AppImage's entry point. Only the bundled zenity runs with the AppImage's own libraries (sharun
# sets them up for it alone), so Proton, Python and the rest of DroidDeck see their usual environment.
APPDIR=${APPDIR:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")}
export UI_ZENITY=$APPDIR/bin/zenity SEVENTHDROID_APPIMAGE=1
exec bash "$APPDIR/share/7thdroid/menu.sh" "$@"
